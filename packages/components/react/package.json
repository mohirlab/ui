{
  "name": "@mohirlab/react",
  "version": "0.1.0",
  "description": "Mohirlab React components.",
  "keywords": [
    "design-system",
    "mohirlab",
    "vanilla-extract"
  ],
  "homepage": "https://github.com/mohirlab/ui/tree/main/packages/components/react#readme",
  "bugs": "https://github.com/mohirlab/ui/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohirlab/ui.git",
    "directory": "packages/components/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@mohirlab/assets": "workspace:^",
    "@mohirlab/icons": "workspace:^",
    "@mohirlab/sprinkles": "workspace:^",
    "@mohirlab/themes": "workspace:^",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.0"
  },
  "devDependencies": {
    "@mohirlab/recipes": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/css": "^1.21.0",
    "@vanilla-extract/vite-plugin": "^5.2.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
