{
  "name": "@mohirlab/themes",
  "version": "0.1.0",
  "description": "Theme contract, light and dark themes and cascade layers for Mohirlab.",
  "keywords": [
    "design-system",
    "mohirlab",
    "vanilla-extract"
  ],
  "homepage": "https://github.com/mohirlab/ui/tree/main/packages/foundation/themes#readme",
  "bugs": "https://github.com/mohirlab/ui/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohirlab/ui.git",
    "directory": "packages/foundation/themes"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@mohirlab/tokens": "workspace:^"
  },
  "devDependencies": {
    "@vanilla-extract/css": "^1.21.0"
  },
  "peerDependencies": {
    "@vanilla-extract/css": "^1.21.0"
  },
  "engines": {
    "node": ">=22"
  }
}
