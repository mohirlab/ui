{
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "70ms" },
      "quick": { "$value": "140ms" },
      "settle": { "$value": "240ms" },
      "slow": { "$value": "420ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.3, 0, 0.2, 1] },
      "enter": { "$value": [0.05, 0.7, 0.1, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] },
      "press": { "$value": [0.2, 0.9, 0.3, 1.25] }
    }
  }
}
