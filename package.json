{
  "name": "mohirlab",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "check:exports": "node scripts/check-exports.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm check:exports && changeset publish",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm check:exports"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "esbuild": "^0.28.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.23.0"
}
